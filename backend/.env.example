# ── Daraja / M-PESA ──────────────────────────────────────────────────────────
# Get these from https://developer.safaricom.co.ke after creating an app

MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here

# Environment: "sandbox" | "production"
MPESA_ENV=sandbox

# Your M-PESA Till Number (Buy Goods) or Paybill shortcode
MPESA_SHORTCODE=174379

# For STK Push: the shortcode that initiates the push (same as above for Till)
MPESA_STK_SHORTCODE=174379

# Lipa Na M-PESA Online passkey (from Daraja portal)
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Callback base URL — must be publicly reachable (use ngrok in dev)
# Example: https://abc123.ngrok.io
CALLBACK_BASE_URL=https://your-ngrok-or-domain.com

# C2B transaction type: "CustomerPayBillOnline" | "CustomerBuyGoodsOnline"
MPESA_C2B_TYPE=CustomerBuyGoodsOnline

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# Allowed frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:8443
